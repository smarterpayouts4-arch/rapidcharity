{
  "name": "rapid-charity-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.ts",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "qa:shots": "node scripts/capture-local-refs.mjs",
    "qa:links": "node scripts/link-audit.mjs",
    "qa:content": "node scripts/content-connection-audit.mjs",
    "qa:content:strict": "node scripts/content-connection-audit.mjs --strict",
    "qa:final:http": "node scripts/final-system-http-audit.mjs",
    "test:sims": "playwright test -c playwright.sims.config.ts",
    "dev:apply": "npm run dev --prefix rapid-application",
    "test:apply": "npm run test --prefix rapid-application",
    "typecheck:apply": "npm run typecheck --prefix rapid-application"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "jose": "^6.2.12",
    "motion": "^14.3.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
