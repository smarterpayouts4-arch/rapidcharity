{
  "name": "rapid-application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && npm --prefix functions run typecheck",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:emulator": "npx --yes firebase-tools@14 emulators:exec --only firestore,auth --project demo-rapid-scholarship \"vitest run tests/integration --no-file-parallelism\"",
    "test:e2e": "playwright test",
    "functions:build": "npm --prefix functions run build",
    "emulators": "npm run functions:build && npx --yes firebase-tools@14 emulators:start --project demo-rapid-scholarship",
    "live:drive": "npx --yes firebase-tools@14 emulators:exec --only firestore --project demo-rapid-scholarship \"tsx scripts/live/drive-bridge-live.ts\"",
    "live:drive:cleanup": "tsx scripts/live/drive-bridge-live.ts cleanup",
    "catalog:audit": "tsx scripts/catalog/audit.ts",
    "catalog:build": "tsx scripts/catalog/build.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vercel/nft": "^1.11.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "firebase-admin": "^13.10.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
