# Browser settings. Copy to .env.local for local work. These values are public in the built app.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-rapid-scholarship
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# 1 = use the local Firebase Emulator Suite (always on in `npm run dev`).
VITE_USE_EMULATORS=1
VITE_APP_ORIGIN=http://localhost:5173

# Production build (apply.rapidcharity.org, second Hosting site in the RAPID Firebase project):
# VITE_FIREBASE_PROJECT_ID=<RAPID project id>
# VITE_FIREBASE_API_KEY=<web app key from Firebase console>
# VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# VITE_FIREBASE_APP_ID=<web app id>
# VITE_USE_EMULATORS=0
# VITE_APP_ORIGIN=https://apply.rapidcharity.org

# Cloud Functions settings are NOT set here. See functions/.env.example and docs/drive-integration.md.
