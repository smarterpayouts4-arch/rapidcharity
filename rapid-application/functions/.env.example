# Cloud Functions parameters. For a real project, copy to functions/.env.<projectId> (not secret values only).
#
# Web-app URL of the deployed drive-bridge/Code.gs (ends in /exec).
DRIVE_BRIDGE_URL=
# Drive folder that receives application folders for this cycle.
#   Test:       "RAPID Spring 2027 Test"  -> 1wEUCIj_AOttFAwu4BxzAYxqPCbsTFH6h
#   Production: the Spring 2027 folder chosen by RAPID (set only at cutover)
DRIVE_ROOT_FOLDER_ID=1wEUCIj_AOttFAwu4BxzAYxqPCbsTFH6h
# Comma-separated staff emails allowed to claim admin access.
STAFF_EMAILS=

# Secrets are stored in Secret Manager, never in files that are committed:
#   firebase functions:secrets:set DRIVE_BRIDGE_SECRET
#   firebase functions:secrets:set SCHOLARSHIP_DUPLICATE_HMAC_SECRET
# For the emulator only, scripts/e2e/stack.ts writes random values to functions/.secret.local.
